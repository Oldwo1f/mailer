# Public URLs
TRAEFIK_WEB_HOST=mailing.aito-flow.com
PUBLIC_URL=https://mailing.aito-flow.com
NUXT_PUBLIC_API_BASE=https://mailing.aito-flow.com/api

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search (any subset)
TAVILY_API_KEY=
YDC_API_KEY=
YOU_API_KEY=
NIMBLE_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=

# Batch pacing
SEND_DELAY_MS=30000

# Email providers — switch MAIL_PROVIDER to rotate free tiers
# resend | brevo | sendgrid | mailjet | mailgun | mailserver | smtp | console
MAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
MAIL_FROM_NAME=

# SMTP direct (optional — Hostinger etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Shared API key between backend ↔ mailserver container
MAILSERVER_API_KEY=change-me-to-a-long-random-string
NUXT_PUBLIC_PRIMEUI_LICENSE=
