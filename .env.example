# Backend
PORT=3001
PUBLIC_URL=http://localhost:3001

# Admin authentication
# Generate with: ADMIN_PASSWORD="your-password" node scripts/hash-admin-password.mjs
ADMIN_PASSWORD_SCRYPT=
ADMIN_ORIGINS=http://localhost:3002
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15

# SQLite (relative to backend/)
DATABASE_PATH=./data/mailer.sqlite

# OpenAI (rédaction + enrichissement)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web search (configure any subset — unused providers are skipped)
TAVILY_API_KEY=
YDC_API_KEY=
YOU_API_KEY=
NIMBLE_API_KEY=
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=

# Email providers (switch via MAIL_PROVIDER or Settings → Email)
MAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
MAIL_FROM_NAME=

# SMTP direct (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Mail relay (/var/www/mailserver)
MAILSERVER_URL=http://127.0.0.1:3000
MAILSERVER_API_KEY=

# Send pacing (ms between each email in a batch)
SEND_DELAY_MS=30000

# Admin (Nuxt) — port 3002 to avoid clash with mailserver :3000
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
NUXT_PUBLIC_PRIMEUI_LICENSE=
